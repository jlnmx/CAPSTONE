# Copy the Session pooler connection string from Supabase Dashboard > Connect.
# Use the exact host and username shown there; keep this file free of real credentials.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional regex for additional trusted preview origins; keep it narrowly scoped.
CORS_ORIGIN_REGEX=
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
PASSWORD_RESET_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=3

# Supabase Realtime: private JWK (one line of JSON, including "kid") of the signing key imported
# into Dashboard > Project Settings > JWT Keys. Server-side only; never an EXPO_PUBLIC_* variable.
REALTIME_JWT_PRIVATE_KEY=
REALTIME_JWT_ALGORITHM=ES256
REALTIME_TOKEN_MINUTES=30

# Gmail API delivery over HTTPS (recommended for the deployed Render API).
# Create OAuth credentials with the https://www.googleapis.com/auth/gmail.send scope.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=

# Optional SMTP fallback for hosts that permit outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Shared sender address; for Gmail API it must be the authorized Gmail account.
SMTP_FROM=

# Optional Twilio credentials for OTPs and alerts by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Groq chat-completions endpoint for free-form chatbot answers.
# Copy a key from GroqCloud and set GROQ_MODEL to a model available to your account.
# Keep the API key server-side; never add it to an EXPO_PUBLIC_* variable.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_TIMEOUT_SECONDS=25

# Server-only API key restricted to Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=

# Server-only API key restricted to Weather API and Air Quality API.
GOOGLE_WEATHER_API_KEY=
