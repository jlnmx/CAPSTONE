{
  "expo": {
    "name": "HANDA",
    "slug": "handa-evacuation",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.handa.evacuation"
    },
    "android": {
      "package": "com.handa.evacuation",
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "scheme": "handa",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HANDA to use your location for nearby evacuation areas and emergency coordination.",
          "locationAlwaysAndWhenInUsePermission": "Allow HANDA to access your location for evacuation coordination."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow HANDA to use your camera to attach incident photos and responder IDs.",
          "photosPermission": "Allow HANDA to access photos you choose for incident reports and responder ID verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HANDA to photograph responder IDs for administrator verification."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "adc8392d-8343-4156-9b1c-0a73a789ba12"
      }
    },
    "owner": "jlnmx"
  }
}
