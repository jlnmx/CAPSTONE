{
  "expo": {
    "name": "HANDA",
    "slug": "handa",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/handa-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.handa.evacuation"
    },
    "android": {
      "package": "com.handa.evacuation",
      "googleServicesFile": "./google-services.json",
      "versionCode": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "scheme": "handa",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HANDA to use your location for nearby evacuation areas and emergency coordination.",
          "locationAlwaysAndWhenInUsePermission": "Allow HANDA to access your location for evacuation coordination."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow HANDA to use your camera to attach incident photos and responder IDs.",
          "photosPermission": "Allow HANDA to access photos you choose for incident reports and responder ID verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HANDA to photograph responder IDs and capture a face photo for superadmin verification."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow HANDA to use Face ID to securely sign you in."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4ab690a5-a38a-4250-8da5-d43eaadd7b4a"
      }
    },
    "owner": "handadevs2s-team"
  }
}
