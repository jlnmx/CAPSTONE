# Copy the Session pooler connection string from Supabase Dashboard > Connect.
# Use the exact host and username shown there; keep this file free of real credentials.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
AUTH_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
PASSWORD_RESET_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=3

# Configure SMTP to deliver password reset codes by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Configure Twilio to deliver password reset codes by SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Groq chat-completions endpoint for free-form chatbot answers.
# Copy a key from GroqCloud and set GROQ_MODEL to a model available to your account.
# Keep the API key server-side; never add it to an EXPO_PUBLIC_* variable.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_TIMEOUT_SECONDS=25
