    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.0",
    "leaflet": "file:../leaflet-2.0.0-alpha.1",
    "typescript": "^5.3.3"
